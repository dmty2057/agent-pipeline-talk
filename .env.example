# The agent and the judge run through the Claude Agent SDK. It uses the login of an installed
# Claude Code (`claude` → /login). Without it, set an API key instead:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Langfuse (telemetry) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Claude Code exports its spans to this OTLP endpoint directly.
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Basic auth header: base64("<public key>:<secret key>")
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 of public:secret>"

# Keep the claude.ai connectors of a logged-in account out of the agent.
ENABLE_CLAUDEAI_MCP_SERVERS=false

# --- fixtures ---
# RECORD_FIXTURES=1 saves every Wikipedia response to data/fixtures/;
# USE_FIXTURES=1 replays them instead of calling Wikipedia.
RECORD_FIXTURES=
USE_FIXTURES=

# Which prompt file in prompts/ to use.
PROMPT_VERSION=v1
